# ---- Copy this file to ".env" and fill in real values ----

# Server
PORT=5000
NODE_ENV=development

# Database (PostgreSQL). Format:
# postgresql://USER:PASSWORD@HOST:PORT/DBNAME?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/aies?schema=public"

# Auth
JWT_SECRET="change-this-to-a-long-random-string"
JWT_EXPIRES_IN="7d"

# CORS — the URL of your frontend (comma-separate multiple)
CLIENT_URL="http://localhost:3000"
